    },
    {
      "source": "/contact/index.html",
      "destination": "/contact/",
      "statusCode": 301
    },
    {
      "source": "/privacy-policy/index.html",
      "destination": "/privacy-policy/",
      "statusCode": 301
    },
    {
      "source": "/Infrastructure/:path*",
      "destination": "/infrastructure/",
      "statusCode": 301
    },
    {
      "source": "/Infrastructure222/:path*",
      "destination": "/infrastructure/",
      "statusCode": 301
    },
    {
      "source": "/contact.php/:path*",
      "destination": "/contact/",
      "statusCode": 301
    },
    {
      "source": "/contact-us/:path*",
      "destination": "/contact/",
      "statusCode": 301
    },
    {
      "source": "/blog22/:path*",
      "destination": "/blog/",
      "statusCode": 301
    },
    {
      "source": "/careers22/:path*",
      "destination": "/careers/",
      "statusCode": 301
    },
    {
      "source": "/series",
      "destination": "/products/",
      "statusCode": 301
    },
    {
      "source": "/series/index.html",
      "destination": "/products/",
      "statusCode": 301
    },
    {
      "source": "/series/galseries.html",
      "destination": "/series/gal-series.html",
      "statusCode": 301
    },
    {
      "source": "/products/z-series.html",
      "destination": "/series/z-series.html",
      "statusCode": 301
    },
    {
      "source": "/products/custome-built/:path*",
      "destination": "/products/custom-built-gearboxes.html",
      "statusCode": 301
    },
    {
      "source": "/products/g-series/Gu-type.html",
      "destination": "/products/gu-type-worm-gearbox.html",
