      "statusCode": 301
    },
    {
      "source": "/blog/Choosing-the-Right G-Series-Gearbox-for-Your-Application.html",
      "destination": "/blog/choosing-the-right-g-series-gearbox-for-your-application.html",
      "statusCode": 301
    },
    {
      "source": "/blog/Choosing-the-Right%20G-Series-Gearbox-for-Your-Application.html",
      "destination": "/blog/choosing-the-right-g-series-gearbox-for-your-application.html",
      "statusCode": 301
    },
    {
      "source": "/blog/G-Series-Gearboxes-Built-for-Reliability-and-Longevity.html",
      "destination": "/blog/g-series-gearboxes-built-for-reliability-and-longevity.html",
      "statusCode": 301
    },
    {
      "source": "/blog/Gisnu-G-Series-Powering-Innovation-in-Industry.html",
      "destination": "/blog/gishnu-g-series-powering-innovation-in-industry.html",
      "statusCode": 301
    },
    {
      "source": "/blog/unlocking-power-with-gishnu-g-serier.html",
      "destination": "/blog/unlocking-power-with-gishnu-g-series-gearboxes.html",
      "statusCode": 301
    },
    {
      "source": "/all-product",
      "destination": "/all-product.html",
      "statusCode": 301
    },
    {
      "source": "/all-products",
      "destination": "/all-product.html",
      "statusCode": 301
    },
    {
      "source": "/all-products.html",
      "destination": "/all-product.html",
      "statusCode": 301
    },
    {
      "source": "/aerator-gearboxes",
      "destination": "/aerator-gearboxes.html",
      "statusCode": 301
    },
    {
      "source": "/about",
      "destination": "/about-us/",
      "statusCode": 301
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy/",
      "statusCode": 301
    },
    {
      "source": "/en/:path*",
      "destination": "/:path*",
      "statusCode": 301
    },
    {
      "source": "/de/:path*",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        }
      ]
    },
    {
      "source": "/assets/(css|js|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(img|og|video)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(favicon.ico|favicon.svg|apple-touch-icon.png|site.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(llms.txt|llms-full.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
